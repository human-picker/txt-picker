{
  "name": "@human-picker/txt-picker",
  "version": "0.1.0",
  "description": "A human-in-the-loop text decision renderer for AI agents",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {"node": ">=22"},
  "files": ["dist", "README.md", "LICENSE"],
  "main": "./dist/txt-picker.js",
  "module": "./dist/txt-picker.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/txt-picker.js"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "dev": "vite --config vite.demo.config.ts",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "build": "npm run typecheck && vite build --config vite.config.ts && vue-tsc -p tsconfig.build.json",
    "build:demo": "vite build --config vite.demo.config.ts",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test tests/*.test.mjs"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vue": "^3.5.20",
    "vue-tsc": "^3.1.0"
  }
}
